  <worksheets>
    <worksheet name='Avg deilvery time(Days)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Bold' fontsize='10'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='olist_order_items_dataset+' name='federated.1l1ig421ki4baf10vib0b17u8vv3' />
          </datasources>
          <datasource-dependencies datasource='federated.1l1ig421ki4baf10vib0b17u8vv3'>
            <column caption='Average delivery time' datatype='real' name='[Calculation_0300234793263109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(DATEDIFF(&apos;day&apos;,[order_purchase_timestamp],[order_delivered_customer_date]))' />
            </column>
            <column caption='Order Delivered Customer Date' datatype='datetime' name='[order_delivered_customer_date]' role='dimension' type='ordinal' />
            <column caption='Order Purchase Timestamp' datatype='datetime' name='[order_purchase_timestamp]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_0300234793263109]' derivation='User' name='[usr:Calculation_0300234793263109:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.1l1ig421ki4baf10vib0b17u8vv3].[usr:Calculation_0300234793263109:qk]' />
            </encodings>
            <style>
              <style-rule element='cell'>
                <format attr='text-align' value='center' />
              </style-rule>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='{4101459D-47AC-4DEF-8308-8A7EB5F859EF}' />
    </worksheet>
    <worksheet name='KPI-1'>
      <table>
        <view>
          <datasources>
            <datasource caption='olist_order_items_dataset+' name='federated.1l1ig421ki4baf10vib0b17u8vv3' />
          </datasources>
          <datasource-dependencies datasource='federated.1l1ig421ki4baf10vib0b17u8vv3'>
            <column caption='Weekend and Weekday' datatype='string' name='[Calculation_0300234714841088]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATENAME(&apos;weekday&apos;,[order_purchase_timestamp])= &apos;Saturday&apos; OR &#13;&#10;DATENAME(&apos;weekday&apos;,[order_purchase_timestamp])= &apos;Sunday&apos;THEN &apos;Weekend&apos;&#13;&#10;ELSE &apos;Weekday&apos;&#13;&#10;END' />
            </column>
            <column caption='% of Price' datatype='real' name='[Calculation_0300234736033795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([price])/TOTAL(SUM([price]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column-instance column='[Calculation_0300234714841088]' derivation='None' name='[none:Calculation_0300234714841088:nk]' pivot='key' type='nominal' />
