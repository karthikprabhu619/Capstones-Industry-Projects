	column 'Years at Company grp' =
			
			SWITCH(TRUE(),
			    'HR Analytics'[YearsAtCompany] <= 2, "0-2",
			    'HR Analytics'[YearsAtCompany] <= 5, "3-5",
			    'HR Analytics'[YearsAtCompany] <= 10, "6-10",
			    'HR Analytics'[YearsAtCompany] <= 20, "11-20",
			    'HR Analytics'[YearsAtCompany] <= 30, "21-30",
			
